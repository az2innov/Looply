# ==============================================================================
# LOOPLY - PRODUCTION & LOCAL TESTING ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. SUPABASE (PostgreSQL Database - London eu-west-2 recommended)
# Get from: https://supabase.com/dashboard/project/_/settings/database
# Connection string with connection pooling (Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Supabase Client API keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. UPSTASH REDIS (Rate Limiting & 2FA OTP Storage - London eu-west-2)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://[YOUR_INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR_UPSTASH_TOKEN]"

# 3. STRIPE (Payments & £0 Deposit Holds)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_51..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 4. SECURITY & AUTH
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-32-character-auth-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
